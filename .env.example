# ---- AlgoForge environment --------------------------------------------------
# Copy to `.env` for local development. Never commit real values.

# MongoDB connection string. Optional locally: when unset (and NODE_ENV is not
# production) the API starts an in-memory MongoDB so you can develop without a
# local install — data is NOT persisted between restarts in that mode.
# Required in production.
MONGODB_URI=

# Secret used to sign session JWTs (HttpOnly cookie). >= 16 chars. Required in production.
JWT_SECRET=

# Port for the local Express API (the Vite dev server proxies /api to it).
SERVER_PORT=4000

# Only needed if the frontend is served from a different origin than the API
# (comma-separated allowed origins). In the default single-origin deployment
# (Vercel: static client + /api function) leave this empty.
CLIENT_ORIGIN=

# Force Secure cookies on/off. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# pino log level: fatal|error|warn|info|debug|trace|silent
# LOG_LEVEL=info

# ---- Optional: online coding workspace (Judge0-compatible judge) ------------
# When JUDGE0_URL is unset the workspace shows an editor + drafts, and the
# "Run" action explains that execution is not configured.
# Self-hosted:  JUDGE0_URL=https://judge0.example.com
# RapidAPI:     JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#               JUDGE0_KEY=<your RapidAPI key>
#               JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_HOST=
